{
  "name": "statisfy",
  "version": "1.2.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:indexes": "prisma db execute --file prisma/indexes.sql",
    "db:studio": "prisma studio",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "import:your-spotify": "node --conditions=react-server --import tsx scripts/import-your-spotify.ts",
    "import:spotify-history": "node --conditions=react-server --import tsx scripts/import-spotify-history.ts",
    "db:backfill-source": "node --conditions=react-server --import tsx scripts/backfill-source.ts",
    "db:backfill-counted": "node --conditions=react-server --import tsx scripts/backfill-counted.ts",
    "db:backfill-play-metadata": "node --conditions=react-server --import tsx scripts/backfill-play-metadata.ts",
    "db:normalize-dedup": "node --conditions=react-server --import tsx scripts/normalize-dedup-keys.ts",
    "migrate:sqlite": "node --conditions=react-server --import tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:restore": "node --conditions=react-server --import tsx scripts/restore-dump.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@openobserve/browser-logs": "^0.4.3",
    "@openobserve/browser-rum": "^0.4.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bson": "^7.3.3",
    "dotenv": "^18.0.6",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swagger-ui-dist": "^5.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "mongodb": "^7.7.0",
    "prettier": "^3.9.10",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
