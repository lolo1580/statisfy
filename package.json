{
  "name": "statisfy",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "import:your-spotify": "node --conditions=react-server --import tsx scripts/import-your-spotify.ts",
    "import:spotify-history": "node --conditions=react-server --import tsx scripts/import-spotify-history.ts",
    "db:backfill-source": "node --conditions=react-server --import tsx scripts/backfill-source.ts",
    "migrate:sqlite": "node --conditions=react-server --import tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:restore": "node --conditions=react-server --import tsx scripts/restore-dump.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bson": "^7.3.3",
    "dotenv": "^18.0.6",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "mongodb": "^7.7.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
