# --- Statisfy : variables d'environnement ---
# Copiez ce fichier vers .env puis renseignez les secrets.

# --- Déploiement Docker (docker-compose) ---
# Par défaut, docker-compose construit l'image depuis les sources (build local).
# L'image GHCR est optionnelle : elle n'est utilisée que si vous décommentez la
# ligne `image:` du docker-compose.yml. La publication de cette image est
# manuelle (workflow GitHub « Docker » → Run workflow).
# STATISFY_IMAGE="ghcr.io/lolo1580/statisfy:latest"

# --- Base de données PostgreSQL ---
# Compte utilisé par le service `db` de docker-compose (et repris dans
# DATABASE_URL). Choisissez un mot de passe sans caractère spécial d'URL
# (`@`, `:`, `/`, `%`, `#`). Générez-le avec : openssl rand -hex 24
POSTGRES_USER="statisfy"
POSTGRES_PASSWORD=""
POSTGRES_DB="statisfy"
# Port PostgreSQL exposé sur l'hôte (dev local). Changez-le si 5432 est pris.
POSTGRES_PORT="5432"

# URL de connexion utilisée en local (hors Docker) ou vers une base externe.
# En Docker, docker-compose la construit à partir des variables ci-dessus.
DATABASE_URL="postgresql://statisfy:motdepasse@localhost:5432/statisfy"

# Secret de signature des sessions. Générez-le avec : openssl rand -base64 32
SESSION_SECRET=""

# Durée de vie absolue d'une session (jours, défaut 7) et timeout d'inactivité
# (heures, défaut 24). Un utilisateur inactif au-delà doit se reconnecter.
# SESSION_TTL_DAYS="7"
# SESSION_IDLE_HOURS="24"

# Clé de chiffrement des identifiants de sources (32 octets, base64).
# Générez-la avec : openssl rand -base64 32
CREDENTIALS_KEY=""

# Nom affiché de l'instance
NEXT_PUBLIC_APP_NAME="Statisfy"

# Jeton pour déclencher la synchronisation via cron (optionnel mais recommandé)
# SYNC_TOKEN="change-moi"
# Intervalle minimal entre deux synchros déclenchées par /api/sync (ms)
# SYNC_MIN_INTERVAL_MS="120000"
# Sauvegardes automatiques : nombre de fichiers conservés
# BACKUP_KEEP="7"
# Rétention du journal d'événements en jours (0 = conservation illimitée)
# LOG_RETENTION_DAYS="90"

# --- Envoi des logs vers un serveur externe (optionnel) ---
# Désactivé par défaut. Valeurs possibles :
#   gelf-http | gelf-udp | gelf-tcp | syslog-udp | syslog-tcp
#   json-http | loki | elasticsearch | otlp-http | file
#   (alias TLS explicites : gelf-tcp-tls | syslog-tcp-tls)
# LOG_SINK=""
# URL de l'endpoint pour les transports HTTP :
#   gelf-http   -> http://graylog:12201/gelf
#   json-http   -> https://logs.example/ingest   (POST JSON générique)
#   loki        -> http://loki:3100               (/loki/api/v1/push ajouté si absent)
#   elasticsearch -> http://es:9200              (/_bulk ajouté si absent)
#   otlp-http   -> http://signoz-otel-collector:4318  (/v1/logs ajouté si absent)
# LOG_SINK_URL=""
# En-têtes HTTP additionnels au format JSON (json-http, loki, elasticsearch, otlp-http)
# LOG_SINK_HEADERS='{"Authorization":"Bearer …"}'
# Index Elasticsearch/OpenSearch (défaut statisfy-logs)
# LOG_SINK_INDEX="statisfy-logs"
# Labels Loki statiques supplémentaires (au format JSON)
# LOG_SINK_LABELS='{"env":"prod"}'
# Sink fichier (Wazuh) : chemin, rotation en Mo et format de ligne (json | raw)
# LOG_SINK_FILE=""
# LOG_SINK_FILE_MAX_MB="10"
# LOG_SINK_FILE_FORMAT="json"
# UDP/TCP : hôte et port (défaut 12201 pour gelf-*, 514 pour syslog-*)
# LOG_SINK_HOST=""
# LOG_SINK_PORT=""
# TLS (transports TCP uniquement)
# LOG_SINK_TLS="false"
# LOG_SINK_TLS_REJECT_UNAUTHORIZED="true"
# LOG_SINK_TLS_CA=""
# Niveau minimal transmis : debug | info | warn | error (défaut info)
# LOG_SINK_MIN_LEVEL="info"
# Nom d'hôte affiché côté Graylog (défaut : nom de l'application)
# LOG_SINK_HOSTNAME=""
# Facility syslog : user, local0…local7 (défaut user, sans effet en GELF)
# LOG_SINK_FACILITY="user"
# Délai d'expédition en ms (défaut 2000)
# LOG_SINK_TIMEOUT_MS="2000"

# --- Fournisseurs (optionnels) ---
# Spotify : https://developer.spotify.com/dashboard
# Redirect URI à autoriser. En local : http://127.0.0.1:3000/... (pas
# « localhost »). En production : une URL HTTPS (obligatoire).
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/sources/spotify/callback"

# URL publique de l'instance (recommandé derrière un reverse proxy).
# Exemple : https://spotify-api.mondomaine.org
APP_URL=""

# Domaine partagé des cookies (optionnel). Utile si l'UI et le callback OAuth
# sont sur des sous-domaines différents, ex. ".mondomaine.org".
COOKIE_DOMAIN=""

# Confiance aux en-têtes de proxy (X-Forwarded-For / X-Real-IP / X-Forwarded-Host).
# Laissez la valeur par défaut derrière un reverse proxy de confiance.
# Mettez `false` si l'application est joignable directement : les en-têtes
# forgés sont alors ignorés. Les valeurs sont de toute façon validées (IP).
# TRUST_PROXY_HEADERS="true"

# Autoriser la création de comptes (true/false)
ALLOW_REGISTRATION="true"
